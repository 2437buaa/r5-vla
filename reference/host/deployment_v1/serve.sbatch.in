#!/usr/bin/env bash
#SBATCH --job-name=r5-vla-preview-server
#SBATCH --partition=gpu
#SBATCH --gres=gpu:1
#SBATCH --cpus-per-task=6
#SBATCH --mem=64G
#SBATCH --time=02:00:00
#SBATCH --nice=0
set -euo pipefail
export PYTHONNOUSERSITE=1 PYTHONDONTWRITEBYTECODE=1
export OMP_NUM_THREADS=2 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1
export HF_HUB_OFFLINE=1 HF_DATASETS_OFFLINE=1 TRANSFORMERS_OFFLINE=1 TOKENIZERS_PARALLELISM=false
export PYTHONPATH={{LINGBOT_SOURCE}}
export TMPDIR="{{SERVER_ROOT}}/tmp/r5s_${SLURM_JOB_ID}"
mkdir -p "$TMPDIR"
R5_CHECK_STEP=${R5_CHECK_STEP:-4000}
{{TRAIN_PYTHON}} -c \
 'import json,os;from pathlib import Path;p=Path(os.environ["R5_DEPLOY_ROOT"])/"OFFLINE_COMPLETE.json";assert json.loads(p.read_text())["status"]=="PASS"'
cd {{LINGBOT_SOURCE}}
exec {{TRAIN_PYTHON}} -u \
 "$R5_DEPLOY_ROOT/scripts/server.py" --step "$R5_CHECK_STEP" --port 18765
