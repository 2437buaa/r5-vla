# Common Orbbec gemini_301_series.launch.py config for both Gemini 305 devices.
# Requires USB3. Set camera_name and serial_number separately at launch.
# Same dimensions/FPS do not imply inter-camera exposure synchronization.
enable_color: true
color_width: 848
color_height: 530
color_fps: 30
color_format: YUYV
enable_depth: true
depth_width: 848
depth_height: 530
depth_fps: 30
depth_format: Y16
enable_left_ir: false
enable_right_ir: false
enable_point_cloud: false
enable_colored_point_cloud: false
enable_frame_sync: false
