# Only recorder subscriptions change. Current image publishers offer RELIABLE.
# Reliable reception is tested separately; it is not a timing/safety guarantee.
/camera_1/color/image_raw: &image_qos
  history: keep_last
  depth: 30
  reliability: reliable
  durability: volatile
/camera_1/depth/image_raw: *image_qos
/camera_2/color/image_raw: *image_qos
/camera_2/depth/image_raw: *image_qos
/r5_pair/follower_status:
  history: keep_last
  depth: 1000
  reliability: reliable
  durability: volatile
/tf_static:
  history: keep_last
  depth: 100
  reliability: reliable
  durability: transient_local
